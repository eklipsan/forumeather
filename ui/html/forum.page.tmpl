{{template "base" .}}
<head>
    {{define "title"}}Прогноз: {{.ForumInfo.Name}}{{end}}
</head>
<body>
    {{define "header"}}
        <h1>{{.ForumInfo.Name}}</h1>
        <p class="description">Детальный прогноз погоды на ближайшие 10 дней.</p>
        <div style="margin-top: 15px;">
            <a href="/" class="btn" style="background-color: #95a5a6;">← Назад к списку</a>
        </div>
    {{end}}

    {{define "main"}}
    <section class="forum-summary">
        <div class="weather-card summary-card">
            <div class="summary-grid">
                <div class="summary-item">
                    <span class="weather-label">Место:</span>
                    <span class="weather-value">{{.ForumInfo.Place}}</span>
                </div>
                <div class="summary-item">
                    <span class="weather-label">Тематика:</span>
                    <span class="weather-value">{{.ForumInfo.Topics}}</span>
                </div>
            </div>
        </div>
    </section>

    <h2 style="margin: 30px 0 20px; color: #2c3e50; text-align: center;">Прогноз на 10 дней</h2>

<section class="forecast-grid">
        {{range .ForumTrend}}
        <div class="weather-card forecast-card">
            <div class="forecast-date">{{ .Time }}</div>

            <div class="condition">{{ .WeatherFromPictocode }}</div>

            <div class="weather-info">
                <div class="weather-item">
                    <div class="weather-label">Днём</div>
                    <div class="weather-value">
                            {{if gt .TemperatureMax 0.0}}
                            <div class="weather-value" style="color: #ff2400">{{printf "%.2f °C" .TemperatureMax}}</div>
                            {{else}}
                            <div class="weather-value" style="color: blue">{{printf "%.2f °C" .TemperatureMax}}</div>
                            {{end}}
                    </div>
                </div>
                <div class="weather-item">
                    <div class="weather-label">Ночью</div>
                    <div class="weather-value">
                            {{if gt .TemperatureMin 0.0}}
                            <div class="weather-value" style="color: #ff2400">{{printf "%.2f °C" .TemperatureMin}}</div>
                            {{else}}
                            <div class="weather-value" style="color: blue">{{printf "%.2f °C" .TemperatureMin}}</div>
                            {{end}}
                    </div>
                </div>

                <div class="weather-item" style="grid-column: span 2; border-top: 1px solid #eee; padding-top: 10px; text-align: center;">
                    <div class="weather-label">Скорость ветра:</div>
                    <div class="weather-value" style="font-size: 14px;">
                        {{ printf "%.2f м/с" .WindSpeedMean }}
                    </div>
                </div>

                <div class="weather-item" style="grid-column: span 2;">
                    <div class="weather-label">Вероятность осадков:</div>
                    <div class="weather-value" style="font-size: 14px;">
                        {{ printf "%d %%" .PrecipitationProbability }}
                    </div>
                </div>


                <div class="weather-item" style="grid-column: span 2;">
                    <div class="weather-label">Процент облачности:</div>
                    <div class="weather-value" style="font-size: 14px;">
                        {{ printf "%d %%" .CloudCoverMean }}
                    </div>
                </div>

                <div class="weather-item" style="grid-column: span 2;">
                    <div class="weather-label">Относительная влажность:</div>
                    <div class="weather-value" style="font-size: 14px;">
                        {{ printf "%d %%" .RelativeHumidity }}
                    </div>
                </div>


                <div class="weather-item" style="grid-column: span 2;">
                    <div class="weather-label">Атмосферное давление:</div>
                    <div class="weather-value" style="font-size: 14px;">
                        {{ printf "%d мм" .SeaLevelPressure }}
                    </div>
                </div>

                <div class="weather-item" style="grid-column: span 2;">
                    <div class="weather-label">Предсказуемость (%):</div>
                    <div class="progress-bar-bg" style="background: #eee; height: 8px; border-radius: 4px; margin-top: 5px;">
                        <div class="progress-bar-fill" style="background: #27ae60; height: 100%; border-radius: 4px; width: {{ .Predictability }}%;"></div>
                    </div>
                </div>
            </div>
        </div>
        {{end}}
    </section>
    {{end}}
</body>