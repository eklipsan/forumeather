{{template "base" .}}
<head>
    {{define "title"}}Forumeather{{end}}
</head>
<body>
    {{define "header"}}
        <h1>Сравнение погоды в городах</h1>
        <p class="description">Добавьте города для сравнения текущих погодных условий. Данные будут обновляться автоматически.</p>
    {{end}}

    {{define "main"}}
        <section class="controls">
            <input type="text" class="city-input" id="cityInput" placeholder="Введите название города...">
            <button class="btn" id="addCityBtn">Добавить город</button>
            <button class="btn" id="clearAllBtn">Очистить все</button>
        </section>

        <section class="comparison-container" id="weatherContainer">
            <!-- Города будут добавляться динамически -->
            {{range .ForumsInfo}}
            <div class="weather-card">
                    <div class="weather-header">
                        <div class="forum-name">{{.Name}}</div>
                    </div>
                    <div class="weather-header">
                        <div class="city-name">{{.Place}}</div>
                    </div>
                    <div class="weather-info">
                        <div class="condition">{{.WeatherFromPictocode}}</div>
                        <div class="weather-item">
                            <div class="weather-label">Ощущается как</div>
                            {{if gt .Temperature 0.0}}
                            <div class="weather-value" style="color: #ff2400">{{printf "%.2f °C" .Temperature}}</div>
                            {{else}}
                            <div class="weather-value" style="color: blue">{{printf "%.2f °C" .Temperature}}</div>
                            {{end}}
                        </div>
                        <div class="weather-item">
                            <div class="weather-label">Высота над уровнем моря, м</div>
                            <div class="weather-value">{{.Height}}</div>
                        </div>
                        <div class="weather-item">
                            <div class="weather-label">Скорость ветра, м/с</div>
                            <div class="weather-value">{{printf "%.2f" .Windspeed}}</div>
                        </div>
                        <div class="weather-item">
                            <div class="weather-label">Тематика форума</div>
                            <div class="weather-value">{{.Topics}}</div>
                        </div>
                    </div>
                </div>
                {{else}}
                <div class="empty-state" id="emptyState">
                    Пока не добавлено ни одного города. Введите название города и нажмите "Добавить город".
                </div>
                {{end}}
        </section>
    {{end}}
</body>
</html>